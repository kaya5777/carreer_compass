<div class="max-w-4xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-2">相性診断</h1>
  <p class="text-gray-600 mb-8">企業の情報と自分の経歴をもとに、AIがマッチ度を100点満点で診断します。</p>

  <%# 企業登録フォーム %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">企業を追加して診断する</h2>
    <%= form_with url: interview_compatibility_diagnosis_index_path, method: :post, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">企業名 <span class="text-red-500">*</span></label>
        <%= f.text_field :company_name, placeholder: "例：株式会社〇〇", class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">求人情報</label>
        <%= f.text_area :job_posting, placeholder: "求人票のテキストや職務内容を貼り付けてください", rows: 4, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">企業情報</label>
        <%= f.text_area :company_info, placeholder: "企業のHP・ミッション・特徴など", rows: 3, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400" %>
      </div>
      <div class="flex justify-end">
        <%= f.submit "診断を始める", class: "bg-orange-600 text-white px-6 py-2 rounded-lg text-sm font-medium hover:bg-orange-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <%# 登録済み企業一覧 %>
  <% if @interview_preps.any? %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">登録済みの企業</h2>
      <div class="space-y-3">
        <% @interview_preps.each do |prep| %>
          <div class="flex justify-between items-center p-3 border border-gray-100 rounded-lg">
            <span class="font-medium text-gray-700"><%= prep.company_name %></span>
            <div class="flex gap-2">
              <%= button_to "診断を始める", interview_compatibility_diagnosis_index_path(interview_prep_id: prep.id), method: :post, class: "bg-orange-600 text-white px-4 py-1.5 rounded-lg text-sm hover:bg-orange-700" %>
              <%= button_to "削除", interview_prep_path(prep), method: :delete, data: { turbo_confirm: "削除しますか？" }, class: "text-sm text-gray-400 hover:text-red-500" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# 過去の診断 %>
  <% if @sessions.any? %>
    <h2 class="text-lg font-semibold text-gray-900 mb-4">過去の診断</h2>
    <div class="space-y-3">
      <% @sessions.each do |session| %>
        <%= link_to interview_compatibility_diagnosis_path(session), class: "block bg-white p-4 rounded-lg shadow-sm border border-gray-100 hover:border-orange-200" do %>
          <p class="font-medium text-gray-900"><%= session.title %></p>
          <p class="text-sm text-gray-500"><%= session.updated_at.strftime("%Y/%m/%d %H:%M") %></p>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
